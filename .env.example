# ============================================
# Rank Chat App — Environment Variables
# Copy this file to .env and fill in real values
# ============================================

# Database
DB_HOST=localhost
DB_NAME=rank_chat_app
DB_USER=root
DB_PASS=

# Voice server HMAC secret (generate with: php -r "echo bin2hex(random_bytes(32));")
# Must match VOICE_SECRET in voice-server/.env
VOICE_SECRET=

# Voice signaling server URL (production: wss://voice.yourdomain.com)
VOICE_SERVER_URL=ws://localhost:3001
